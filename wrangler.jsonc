{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasista-review-202605",
  "compatibility_date": "2026-05-18",
  "pages_build_output_dir": "./public",
  "assets": {
    "directory": "./public"
  },
  "vars": {
    "ENVIRONMENT": "preview"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fantasista-review-202605-preview",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fantasista-review-202605-preview",
          "database_id": "00000000-0000-0000-0000-000000000001"
        }
      ]
    },
    "staging": {
      "vars": {
        "ENVIRONMENT": "preview"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fantasista-review-202605-staging",
          "database_id": "00000000-0000-0000-0000-000000000002"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fantasista-review-202605-production",
          "database_id": "00000000-0000-0000-0000-000000000003"
        }
      ]
    }
  }
}
